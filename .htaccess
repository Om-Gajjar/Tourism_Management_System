# ==============================================================================
# Tourism Management System - Root .htaccess
# Handles routing to /public and secures private directories on Apache web servers
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Follow symbolic links (required for mod_rewrite)
Options +FollowSymLinks

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent access to private and sensitive directories
    RewriteRule ^(src|database|docs|logs|tests|\.git) - [F,L,NC]

    # Prevent direct access to sensitive root files
    RewriteRule ^(router\.php|start\.sh|\.gitignore|config\.php\.example|composer\.(json|lock)) - [F,L,NC]
    RewriteRule \.(env|log|sql|bak|orig|sh)$ - [F,L,NC]

    # Rewrite all public traffic to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden files (starting with a dot)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
